{
    "diffEditor.ignoreTrimWhitespace": false,   // En las comparaciones (diff) muestra también los cambios de espacios al inicio/final de línea
    "git.enableSmartCommit": true,              // Si no hay nada en el stage, al hacer commit incluye todos los cambios automáticamente
    "git.confirmSync": false,                   // No pide confirmación al sincronizar (pull + push) con el remoto
    "claudeCode.preferredLocation": "panel",    // Abre Claude Code en el panel inferior en vez de en la barra lateral

    "editor.autoClosingBrackets": "never",      // no cierra las llaves automáticamente
    "editor.autoClosingQuotes": "never",        // no cierra comillas automáticamente
    "editor.autoSurround": "never",             // no envuelve la selección al escribir ( o "
    "editor.autoClosingOvertype": "never",      // no "salta" sobre el ) de cierre al teclearlo
    "editor.wordWrap": "on",                    // activo el word wrap por defecto (se activa/desactiva con alt+z)
    "editor.minimap.enabled": false,             // Quito el minimapa
    "editor.inlineSuggest.edits.showLongDistanceHint": false,
    "github.copilot.nextEditSuggestions.allowWhitespaceOnlyChanges": false,
    "github.copilot.nextEditSuggestions.enabled": false,
    "github.copilot.nextEditSuggestions.extendedRange": false,
    "github.copilot.nextEditSuggestions.fixes": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "latex-package": false
    },
    "latex-workshop.view.pdf.invert": 1         // Colores del visor de PDF de LaTeX invertidos (1) o normales (0); se cambia con ctrl+alt+i (ver keybindings.json)
    //"[markdown]": { "editor.wordWrap": "on" },    // Puedo hacer las cosas por lenguaje si quisiera
    //"[latex]": { "editor.wordWrap": "on" }
}
