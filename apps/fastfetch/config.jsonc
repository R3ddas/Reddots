{ // Inicio del objeto de configuración
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json", // Esquema JSON para autocompletado y validación en el editor
    "logo": null, // Desactiva el logo/ASCII art (no se muestra ninguno)
    "display": { // Opciones generales de presentación de la salida
        "separator": "  ", // Texto que separa la clave del valor en cada módulo
        "color": "white", // Color por defecto del texto
        "constants": ["\u001b[37m", "\u001b[38;5;16m", "\u001b[38;5;17m", "\u001b[38;5;18m"] // Códigos ANSI reutilizables (referenciados como $1, $2... en otros valores)
    }, // Cierra "display"
    "modules": [ // Lista ordenada de módulos que se mostrarán
        "break",
        {
            "type": "custom",
            "key": "╭───────────────────────────────────╮"
        },
        {
            "type": "kernel",
            "key": "│ {$2}{$1}  kernel",
            "format": "{$2}{release>22}{$1} │"
        },
        { // Módulos propios de fastfetch y no "command": un "command" lanza un sh cada vez que se abre una terminal
            "type": "uptime",
            "key": "│   uptime",
            "format": "{formatted>22} │"
        },
        {
            "type": "shell",
            "key": "│ {$2}{$1}  shell ",
            "format": "{$2}{pretty-name>22}{$1} │"
        },
        {
            "type": "memory",
            "key": "│ {$3}{$1}  mem   ",
            "format": "{$3}{used>10} / {total>9}{$1} │"  // 10 + " / " + 9 = 22, el ancho de las demás líneas
        },
        {
            "type": "packages",
            "key": "│   pkgs  ",
            "format": "{all>22} │"
        },
        { // El módulo "title" ya sabe el usuario y el nombre del equipo
            "type": "title",
            "key": "│ {$2}{$1}  user  ",
            "format": "{$2}{user-name>22}{$1} │"
        },
        {
            "type": "title",
            "key": "│   hname ",
            "format": "{host-name>22} │"
        },
        {
            "type": "os",
            "key": "│ {$4}󰻀{$1}  distro",
            "format": "{$4}{pretty-name>22}{$1} │"
        },
        {
            "type": "custom",
            "key": "╰───────────────────────────────────╯"
        },
        "break"
    ]
}
